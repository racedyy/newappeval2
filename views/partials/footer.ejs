    </main>
    <footer class="footer mt-auto py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">© <%= new Date().getFullYear() %> ERPNext Integration. Tous droits réservés.</span>
        </div>
    </footer>

    <style>
        html {
            position: relative;
            min-height: 100%;
        }
        
        body {
            margin-bottom: 60px; /* Hauteur du footer */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            height: 60px; /* Hauteur du footer */
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
            z-index: 1030;
        }

        /* Ajouter un padding en bas du contenu principal pour éviter qu'il soit caché par le footer */
        .container {
            padding-bottom: 70px;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <% if (locals.scripts) { %>
        <% scripts.forEach(function(script) { %>
            <script src="<%= script %>"></script>
        <% }); %>
    <% } %>
</body>
</html>
