<%- include('../partials/header') %>

<!-- FullCalendar Bundle -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
<link href="/css/calendar.css" rel="stylesheet">

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="h3">Calendrier des événements</h1>
        </div>
    </div>

    <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert">
            <%= error %>
        </div>
    <% } %>

    <div class="card">
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary active" data-filter="all">Tous</button>
                        <button type="button" class="btn btn-outline-success" data-filter="invoice">Factures</button>
                        <button type="button" class="btn btn-outline-info" data-filter="quotation">Devis</button>
                    </div>
                </div>
            </div>
            <div id="calendar"></div>
        </div>
    </div>
</div>

<!-- Modal pour les détails -->
<div class="modal fade" id="eventModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="event-details"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <a href="#" class="btn btn-primary view-details">Voir détails</a>
            </div>
        </div>
    </div>
</div>

<script src="/js/calendar.js"></script>

<%- include('../partials/footer') %>