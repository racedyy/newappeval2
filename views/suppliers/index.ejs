<style>
            body {
            font-family: Arial, sans-serif;
            margin: 0;
            /* padding: 20px; */
            background-color: #f5f5f5;
        }
</style>
<%- include('../partials/header') %>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="h3 mb-4">Fournisseurs</h1>
        </div>
        <div class="col-md-6">
            <form method="GET" class="d-flex justify-content-end">
                <div class="input-group" style="max-width: 300px;">
                    <select name="status" class="form-select">
                        <option value="">Tous les statuts</option>
                        <option value="active" <%= locals.status === 'active' ? 'selected' : '' %>>Actif</option>
                        <option value="inactive" <%= locals.status === 'inactive' ? 'selected' : '' %>>Inactif</option>
                        <option value="blocked" <%= locals.status === 'blocked' ? 'selected' : '' %>>Bloqué</option>
                    </select>
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i> Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <% if (locals.error) { %>
        <div class="alert alert-danger" role="alert">
            <%= error %>
        </div>
    <% } %>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Groupe</th>
                            <th>Pays</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (suppliers && suppliers.length > 0) { %>
                            <% suppliers.forEach(supplier => { %>
                                <tr>
                                    <td><%= supplier.supplier_name %></td>
                                    <td><%= supplier.supplier_group %></td>
                                    <td><%= supplier.country || '-' %></td>
                                    <td><%= supplier.supplier_type || '-' %></td>
                                    <td>
                                        <a href="/fournisseurs/<%= supplier.name %>" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Voir détails
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    Aucun fournisseur trouvé
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
