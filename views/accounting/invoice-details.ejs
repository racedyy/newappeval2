<%- include('../partials/header') %>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 mb-0">Facture <%= invoice.name %></h1>
            <a href="/accounting" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Informations de la facture -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Détails de la facture</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong>Fournisseur :</strong> <%= invoice.supplier %></p>
                            <p><strong>Date :</strong> <%= new Date(invoice.posting_date).toLocaleDateString() %></p>
                            <p><strong>Échéance :</strong> <%= new Date(invoice.due_date).toLocaleDateString() %></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Total :</strong> <%= invoice.grand_total.toLocaleString() %> €</p>
                            <p><strong>Montant payé :</strong> <%= invoice.paid_amount.toLocaleString() %> €</p>
                            <p><strong>Reste à payer :</strong> <%= invoice.outstanding_amount.toLocaleString() %> €</p>
                        </div>
                    </div>

                    <!-- Articles de la facture -->
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th>Description</th>
                                    <th>Quantité</th>
                                    <th>Prix unitaire</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% invoice.items.forEach(item => { %>
                                    <tr>
                                        <td><%= item.item_code %></td>
                                        <td><%= item.description || item.item_name %></td>
                                        <td><%= item.qty %></td>
                                        <td><%= item.rate.toLocaleString() %> €</td>
                                        <td><%= item.amount.toLocaleString() %> €</td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulaire de paiement -->
        <div class="col-md-4">
            <% if (invoice.outstanding_amount > 0) { %>
                <div class="card" id="payment">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Effectuer un paiement</h5>
                    </div>
                    <div class="card-body">
                        <div id="paymentAlert" class="alert d-none" role="alert"></div>
                        <form id="paymentForm">
                            <div class="mb-3">
                                <label for="amount" class="form-label">Montant</label>
                                <input type="number" 
                                       class="form-control" 
                                       id="amount" 
                                       name="amount" 
                                       step="0.01" 
                                       max="<%= invoice.outstanding_amount %>" 
                                       value="<%= invoice.outstanding_amount %>"
                                       required>
                            </div>
                            <div class="mb-3">
                                <label for="paymentDate" class="form-label">Date du paiement</label>
                                <input type="date" 
                                       class="form-control" 
                                       id="paymentDate" 
                                       name="paymentDate" 
                                       value="<%= new Date().toISOString().split('T')[0] %>"
                                       required>
                            </div>
                            <div class="mb-3">
                                <label for="paymentMode" class="form-label">Mode de paiement</label>
                                <select class="form-select" id="paymentMode" name="paymentMode" required>
                                    <option value="">Sélectionner...</option>
                                    <% paymentModes.forEach(mode => { %>
                                        <option value="<%= mode.name %>"><%= mode.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-cash"></i> Effectuer le paiement
                            </button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const paymentForm = document.getElementById('paymentForm');
    const alertDiv = document.getElementById('paymentAlert');

    if (paymentForm) {
        paymentForm.addEventListener('submit', async function(e) {
            e.preventDefault();

            try {
                const formData = {
                    invoiceId: '<%= invoice.name %>',
                    amount: document.getElementById('amount').value,
                    paymentDate: document.getElementById('paymentDate').value,
                    paymentMode: document.getElementById('paymentMode').value
                };

                const response = await fetch('/accounting/api/payment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (result.success) {
                    alertDiv.className = 'alert alert-success';
                    alertDiv.textContent = result.message;
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    alertDiv.className = 'alert alert-danger';
                    alertDiv.textContent = result.message;
                }
                alertDiv.classList.remove('d-none');
            } catch (error) {
                console.error('Error processing payment:', error);
                alertDiv.className = 'alert alert-danger';
                alertDiv.textContent = 'Erreur lors du traitement du paiement';
                alertDiv.classList.remove('d-none');
            }
        });
    }
});
</script>

<%- include('../partials/footer') %>
